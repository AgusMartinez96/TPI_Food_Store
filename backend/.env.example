# Copiar a .env y completar. Usar siempre localhost (no 127.0.0.1) para que la cookie viaje.
# PostgreSQL: postgresql://usuario:clave@localhost:5432/foodstore_db
DATABASE_URL=sqlite:///./foodstore.db
# Mínimo 32 caracteres. Generar una propia: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
